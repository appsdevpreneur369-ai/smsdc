# Show "Draft" badges on placeholder content (switch on for the demo to show what's pending)
NEXT_PUBLIC_SHOW_PLACEHOLDER_BADGES=false

# Public URL of the site (canonical links, sitemap, Open Graph). Defaults to clinic.json siteUrl.
NEXT_PUBLIC_SITE_URL=

# Phase 2: live Google reviews (not implemented yet — see reviews.json)
# GOOGLE_PLACES_API_KEY=

# ClinicFlow247 booking API (defaults in content/booking.json). Staging builds point at the staging API.
NEXT_PUBLIC_CLINICFLOW_API_URL=

# Staging/demo only: shows "use code 123456" on the OTP step while ClinicFlow SMS is in dry-run. Leave empty in production.
NEXT_PUBLIC_BOOKING_OTP_HINT=
