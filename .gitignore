# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# logs
*.log
logs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (never commit secrets; .env.example is the documented template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local QA output
/qa/

# Lighthouse HTML reports are large; scores are kept in docs/seo-reports/*/summary.json
docs/seo-reports/**/*.html
